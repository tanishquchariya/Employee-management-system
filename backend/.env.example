PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ems
JWT_SECRET=change_this_to_a_long_random_string

# First admin account, created automatically on startup when no admin exists
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeMe@123

# Business timezone used for "today" in attendance and leave (default Asia/Kolkata)
# APP_TIMEZONE=Asia/Kolkata

# Extra allowed frontend origins (comma separated), e.g. deployed admin/employee panels
# CLIENT_URLS=https://admin.example.com,https://employee.example.com

# Profile images: leave blank to store them in backend/uploads, or set an ImageKit key
IMAGEKIT_PRIVATE_KEY=

# Email OTP (config/brevo.js) - not used by the current screens
BREVO_API_KEY=
